# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
env/
.env/
.venv/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Test coverage reports
.coverage
htmlcov/
coverage/
.coverage.*
coverage.xml
*.cover

# Data files
*.sql
*.csv
*.json

# If you have specific data files you want to include despite the above rules, use:
# !important_data.json
# !seed_data.sql

# But track these specific files
!config.json
!schema.sql
!important_seed_data.csv 